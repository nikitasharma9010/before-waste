# Set in Vercel > Project > Settings > Environment Variables, then redeploy.
# Select Production and Preview if judges will use a preview deployment.
# Never use a VITE_ prefix for a secret. Basic guidance works without a key.
GEMINI_API_KEY=

# Optional; defaults to gemini-3.8-flash. Must be available to your Google project.
GEMINI_MODEL=gemini-3.8-flash

# Locally: copy this file to .env.local, fill in the key, restart npm run dev.
